# ================================================================
# PROJECT OVERVIEW
# Structure:
#   1) Period 1: Instagram → Facebook → Website
#   2) Period 2: Instagram & Facebook
#   3) Cross-period comparison (P1 vs P2)
# Visual choices (diverse, purposeful):
#   - Snapshot bars for quick totals
#   - Donut chart for website traffic share
#   - Lollipop chart for Engagement Rate
#   - Line chart for simple P1→P2 trend
# ================================================================
# Avoid pop-up device prompts on macOS; render to RStudio pane
if (interactive()) options(device = "RStudioGD")
options(device.ask.default = FALSE)
# Core libraries
library(ggplot2)
library(dplyr)
library(tidyr)
library(scales)
# Palette + unified theme
aa_colors <- c("#6A3BAE", "#E8DAF7", "#F9E29A")
theme_aa <- function() {
theme_minimal(base_family = "Helvetica") +
theme(
plot.title  = element_text(face = "bold", color = "#6A3BAE", size = 14, hjust = 0.5),
axis.title  = element_text(color = "#6A3BAE"),
axis.text   = element_text(color = "#2E2E2E"),
panel.grid.minor = element_blank()
)
}
# Period parameters
posts_p1 <- 10; days_p1 <- 30
posts_p2 <- 11; days_p2 <- 26
# Inputs from screenshots
ig_p1 <- list(
views = 311, interactions = 22, reach = 31,
views_followers = 229, views_nonfollowers = 82,
reach_followers = 29,  reach_nonfollowers = 2,
posts = posts_p1
)
# KPI table (ER base = Views)
ig_p1_kpi <- tibble::tibble(
Platform = "Instagram", Period = "P1 (Aug12–Sep10)",
Posts = ig_p1$posts, Views = ig_p1$views, Interactions = ig_p1$interactions, Reach = ig_p1$reach
) |>
mutate(
ER_byViews     = Interactions / Views,
Views_perPost  = Views / Posts,
Inter_perPost  = Interactions / Posts,
Reach_perPost  = Reach / Posts,
Posts_perWeek  = Posts / (days_p1/7)
)
ig_p1_kpi
# Snapshot bar
ig_p1_df <- tibble::tibble(
Metric = c("Views","Interactions","Reach"),
Value  = c(ig_p1$views, ig_p1$interactions, ig_p1$reach)
)
p1_instagram_bar <- ggplot(ig_p1_df, aes(Metric, Value, fill = Metric)) +
geom_col(width = 0.6) +
scale_fill_manual(values = aa_colors) +
labs(title = "Instagram Metrics Overview (Period 1)", y = "Count", x = NULL) +
geom_text(aes(label = Value), vjust = -0.4, size = 3.2) +
theme_aa()
p1_instagram_bar
# Followers vs Non-followers (Views & Reach) — audience mix
ig_p1_follow <- dplyr::bind_rows(
tibble::tibble(group=c("Followers","Non-followers"),
value=c(ig_p1$views_followers, ig_p1$views_nonfollowers),
metric="Views"),
tibble::tibble(group=c("Followers","Non-followers"),
value=c(ig_p1$reach_followers, ig_p1$reach_nonfollowers),
metric="Reach")
)
p1_instagram_followers <- ggplot(ig_p1_follow, aes(group, value, fill = group)) +
geom_col(width = 0.6) +
facet_wrap(~ metric, scales = "free_y") +
scale_fill_manual(values = c("#6A3BAE","#E8DAF7")) +
labs(title = "Instagram (P1) — Followers vs Non-followers", x = NULL, y = "Count") +
geom_text(aes(label = value), vjust = -0.4, size = 3.1) +
theme_aa()
p1_instagram_followers
# Inputs from screenshots
fb_p1 <- list(
views = 304, interactions = 20, reach = 72,
views_followers = 163, views_nonfollowers = 141,
reach_followers = 24,  reach_nonfollowers = 48,
posts = posts_p1
)
fb_p1_kpi <- tibble::tibble(
Platform = "Facebook", Period = "P1 (Aug12–Sep10)",
Posts = fb_p1$posts, Views = fb_p1$views, Interactions = fb_p1$interactions, Reach = fb_p1$reach
) |>
mutate(
ER_byViews     = Interactions / Views,
Views_perPost  = Views / Posts,
Inter_perPost  = Interactions / Posts,
Reach_perPost  = Reach / Posts,
Posts_perWeek  = Posts / (days_p1/7)
)
fb_p1_kpi
fb_p1_df <- tibble::tibble(
Metric = c("Views","Interactions","Reach"),
Value  = c(fb_p1$views, fb_p1$interactions, fb_p1$reach)
)
p1_facebook_bar <- ggplot(fb_p1_df, aes(Metric, Value, fill = Metric)) +
geom_col(width = 0.6) +
scale_fill_manual(values = aa_colors) +
labs(title = "Facebook Metrics Overview (Period 1)", y = "Count", x = NULL) +
geom_text(aes(label = Value), vjust = -0.4, size = 3.2) +
theme_aa()
p1_facebook_bar
fb_p1_follow <- dplyr::bind_rows(
tibble::tibble(group=c("Followers","Non-followers"),
value=c(fb_p1$views_followers, fb_p1$views_nonfollowers),
metric="Views"),
tibble::tibble(group=c("Followers","Non-followers"),
value=c(fb_p1$reach_followers, fb_p1$reach_nonfollowers),
metric="Reach")
)
p1_facebook_followers <- ggplot(fb_p1_follow, aes(group, value, fill = group)) +
geom_col(width = 0.6) +
facet_wrap(~ metric, scales = "free_y") +
scale_fill_manual(values = c("#6A3BAE","#E8DAF7")) +
labs(title = "Facebook (P1) — Followers vs Non-followers", x = NULL, y = "Count") +
geom_text(aes(label = value), vjust = -0.4, size = 3.1) +
theme_aa()
p1_facebook_followers
# Sessions and share
web_p1 <- data.frame(
Source   = c("Direct","Google","Bing","Yahoo","primarycarekids.com","Facebook"),
Sessions = c(76,64,9,4,4,1)
) |>
mutate(Share = Sessions / sum(Sessions))
# Yüzde ve etiketleri hazırla
web_p1_labs <- web_p1 %>%
mutate(
perc  = Share / sum(Share),
label = scales::percent(perc, accuracy = 0.1)
)
aa_cols <- c(
"Bing"                  = "#6A3BAE",
"Direct"                = "#E8DAF7",
"Facebook"              = "#F9E29A",
"Google"                = "#D7C9F3",
"primarycarekids.com"   = "#B399E5",
"Yahoo"                 = "#9B82D5"
)
p1_website_donut <- ggplot(web_p1_labs, aes(x = 2, y = Share, fill = Source)) +
geom_col(width = 1, color = "white") +
geom_text(
aes(label = ifelse(perc > 0.03, label, "")),
position = position_stack(vjust = 0.5),
size = 4.2, fontface = "bold", color = "black"
) +
coord_polar(theta = "y") +
xlim(0.5, 2.5) +
scale_fill_manual(values = aa_cols, drop = FALSE) +
labs(title = "Website Traffic Share (Period 1)") +
theme_void() +
theme(
plot.title = element_text(face = "bold", color = "#6A3BAE", hjust = 0.5),
legend.title = element_blank(),
legend.position = "right",
legend.text = element_text(color = "#2E2E2E")
)
p1_website_donut
p1_website_bars <- ggplot(web_p1, aes(reorder(Source, -Sessions), Sessions, fill = Source)) +
geom_col() +
scale_fill_manual(values = c("#F6D44C","#6A3BAE","#FAE89A","#A6A6A6","#D7C9F3","#E8DAF7")) +
geom_text(aes(label = paste0(Sessions, " (", percent(Share, 0.1), ")")),
vjust = -0.35, size = 3.1) +
labs(title = "Website Traffic by Source (Period 1)", x = "Traffic Source", y = "Site Sessions") +
theme_aa() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
p1_website_bars
# From screenshots (interactions are not visible -> NA for now)
ig_p2 <- list(views = 825, interactions = NA_real_, reach = 40, posts = posts_p2)
fb_p2 <- list(views = 631, interactions = NA_real_, reach = 175, posts = posts_p2)
p2_df <- tibble::tibble(
Platform     = c("Instagram","Facebook"),
Period       = "P2 (Sep26–Oct21)",
Posts        = c(ig_p2$posts, fb_p2$posts),
Views        = c(ig_p2$views, fb_p2$views),
Interactions = c(ig_p2$interactions, fb_p2$interactions),
Reach        = c(ig_p2$reach, fb_p2$reach)
) |>
mutate(
ER_byViews     = ifelse(!is.na(Interactions) & Views>0, Interactions/Views, NA_real_),
Views_perPost  = Views / Posts,
Inter_perPost  = ifelse(!is.na(Interactions), Interactions/Posts, NA_real_),
Reach_perPost  = Reach / Posts,
Posts_perWeek  = Posts / (days_p2/7)
)
p2_df
# Snapshot bars for P2, faceted by Platform
p2_long <- p2_df |>
select(Platform, Views, Interactions, Reach) |>
pivot_longer(-Platform, names_to = "Metric", values_to = "Value")
p2_snapshot_bars <- ggplot(p2_long, aes(Metric, Value, fill = Metric)) +
geom_col(width = 0.6, na.rm = TRUE) +
scale_fill_manual(values = aa_colors) +
facet_wrap(~ Platform, scales = "free_y") +
labs(title = "Platform Metrics Overview (Period 2)", y = "Count", x = NULL) +
geom_text(aes(label = ifelse(is.na(Value), "", Value)), vjust = -0.4, size = 3.0, na.rm = TRUE) +
theme_aa()
p2_snapshot_bars
# Build combined KPI table to power comparison visuals
p1_df <- dplyr::bind_rows(ig_p1_kpi, fb_p1_kpi) |> mutate(Period = "P1 (Aug12–Sep10)")
p2_df <- p2_df |> mutate(Period = "P2 (Sep26–Oct21)")
both <- dplyr::bind_rows(p1_df, p2_df) |>
select(Period, Platform, Posts, Views, Interactions, Reach,
ER_byViews, Views_perPost, Inter_perPost, Reach_perPost, Posts_perWeek)
both
# Lollipop for Engagement Rate (with missing-data annotation)
er_tbl <- both |> select(Period, Platform, ER_byViews) |> na.omit()
cmp_lollipop_er <- ggplot(er_tbl, aes(x = Platform, y = ER_byViews * 100, color = Period)) +
geom_segment(aes(x = Platform, xend = Platform, y = 0, yend = ER_byViews * 100),
linewidth = 1.2, position = position_dodge(width = 0.6)) +
geom_point(size = 4.8, position = position_dodge(width = 0.6)) +
geom_text(
aes(label = sprintf("%.1f%%", ER_byViews * 100)),
position = position_dodge(width = 0.6),
vjust = -1.0,
size = 4.4,
fontface = "bold",
color = "black"
) +
labs(
title = "Engagement Rate by Views (%) — P1 vs P2",
x = NULL,
y = "ER (%)",
caption = "Note: P2 interaction data not available, therefore ER only computed for P1."
) +
scale_color_manual(values = c("P1 (Aug12–Sep10)"="#6A3BAE", "P2 (Sep26–Oct21)"="#F9E29A")) +
expand_limits(y = max(er_tbl$ER_byViews * 100) + 1) +
coord_cartesian(clip = "off") +
theme_aa() +
theme(
plot.caption = element_text(hjust = 0.5, color = "gray30", size = 9)
)
cmp_lollipop_er
brand_cols <- c(
"Instagram" = "#6A3BAE",
"Facebook"  = "#F9E29A"
)
trend_df <- data.frame(
Platform = c("Instagram","Instagram","Facebook","Facebook"),
Period   = factor(c("P1 (Aug12–Sep10)","P2 (Sep26–Oct21)",
"P1 (Aug12–Sep10)","P2 (Sep26–Oct21)"),
levels = c("P1 (Aug12–Sep10)","P2 (Sep26–Oct21)")),
Views    = c(311, 825, 304, 631)
)
labels_df <- trend_df %>%
group_by(Platform) %>%
arrange(Period) %>%
mutate(pct_change = ifelse(row_number()==2,
(Views - lag(Views)) / lag(Views), NA_real_)) %>%
filter(!is.na(pct_change)) %>%
ungroup()
views_grouped_bar <- ggplot(trend_df, aes(Period, Views, fill = Platform)) +
geom_col(position = position_dodge(width = 0.6), width = 0.55) +
geom_text(aes(label = Views),
position = position_dodge(width = 0.6),
vjust = -0.4, size = 3.2) +
scale_fill_manual(values = brand_cols) +
labs(title = "Views by Period and Platform", x = "Period", y = "Views") +
theme_minimal(base_family = "Helvetica") +
theme(
plot.title = element_text(face = "bold", color = "#6A3BAE", size = 14, hjust = 0.5),
axis.title = element_text(color = "#6A3BAE"),
axis.text  = element_text(color = "#2E2E2E")
)
views_grouped_bar
views_line_trend <- ggplot(trend_df, aes(Period, Views, group = Platform, color = Platform)) +
geom_line(linewidth = 1.6) +
geom_point(size = 3.8) +
geom_text(
data = labels_df,
aes(x = Period, y = Views, label = paste0("+", round(pct_change*100, 0), "%")),
vjust = -0.6, size = 3.0, fontface = "bold",
inherit.aes = FALSE
) +
scale_color_manual(values = brand_cols) +
labs(title = "Views Trend (P1 → P2)", x = "Period", y = "Views") +
theme_minimal(base_family = "Helvetica") +
theme(
plot.title = element_text(face = "bold", color = "#6A3BAE", size = 12, hjust = 0.5),
axis.title = element_text(color = "#6A3BAE"),
axis.text  = element_text(color = "#2E2E2E"),
legend.position = "right"
)
views_line_trend
# =========================
# Posting cadence vs performance (P1 vs P2)
# Chart: posts/week  ⟶  avg views/post
# One plot per platform (Instagram, Facebook)
# =========================
# (library ve theme_aa zaten yukarıda yüklü, tekrar yüklemiyoruz)
# ---- Theme & brand colors (sadece renkler) ----
brand_cols <- c("Instagram" = "#6A3BAE", "Facebook" = "#B196F3")
# ---- Input data ----
posts_p1 <- 10; days_p1 <- 30
posts_p2 <- 11; days_p2 <- 26
ig_views_p1 <- 311; ig_views_p2 <- 825
fb_views_p1 <- 304; fb_views_p2 <- 631
# ---- Tidy table ----
cadence_tbl <- bind_rows(
tibble(
Platform = "Instagram",
Period   = c("P1 (Aug12–Sep10)", "P2 (Sep26–Oct21)"),
Posts    = c(posts_p1, posts_p2),
Days     = c(days_p1,  days_p2),
Views    = c(ig_views_p1, ig_views_p2)
),
tibble(
Platform = "Facebook",
Period   = c("P1 (Aug12–Sep10)", "P2 (Sep26–Oct21)"),
Posts    = c(posts_p1, posts_p2),
Days     = c(days_p1,  days_p2),
Views    = c(fb_views_p1, fb_views_p2)
)
) |>
mutate(
posts_per_week = Posts / (Days/7),
avg_views_post = Views / Posts
)
# ---- Clean plot function ----
plot_cadence_single <- function(dat, platform, color_hex) {
ggplot(dat, aes(posts_per_week, avg_views_post)) +
geom_path(linewidth = 1.2, color = color_hex, alpha = 0.55,
arrow = arrow(type = "closed", length = unit(6, "pt"))) +
geom_point(size = 4, color = color_hex) +
scale_x_continuous(
name = "Posts per Week",
breaks = pretty(dat$posts_per_week, n = 4),
expand = expansion(mult = c(0.08, 0.25))
) +
scale_y_continuous(
name = "Average Views per Post",
breaks = pretty(dat$avg_views_post, n = 5),
expand = expansion(mult = c(0.08, 0.20))
) +
labs(
title = paste0(platform, " (posts/week vs. avg views/post)"),
subtitle = "Arrows show change from P1 to P2"
) +
coord_cartesian(clip = "off") +
theme_aa()
}
ig_df <- cadence_tbl |> filter(Platform == "Instagram")
fb_df <- cadence_tbl |> filter(Platform == "Facebook")
# ---- Plot objeleri (ilk yaptığımız gibi isimli) ----
p_instagram <- plot_cadence_single(ig_df, "Instagram", brand_cols["Instagram"])
p_facebook  <- plot_cadence_single(fb_df, "Facebook",  brand_cols["Facebook"])
cadence_lbl <- cadence_tbl |>
mutate(
nudge_x = ifelse(Platform == "Instagram",  0.08, -0.08),
nudge_y = ifelse(Platform == "Instagram",  6,    -6)
)
p_combined <- ggplot(cadence_lbl,
aes(posts_per_week, avg_views_post, color = Platform, group = Platform)) +
geom_path(linewidth = 1.2,
arrow = arrow(type = "closed", length = unit(6, "pt")), alpha = 0.55) +
geom_point(size = 4) +
scale_color_manual(values = brand_cols) +
scale_x_continuous(
name = "Posts per Week",
breaks = pretty(cadence_lbl$posts_per_week, n = 4),
expand = expansion(mult = c(0.08, 0.25))
) +
scale_y_continuous(
name = "Average Views per Post",
breaks = pretty(cadence_lbl$avg_views_post, n = 5),
expand = expansion(mult = c(0.08, 0.20))
) +
labs(
title = "Instagram vs. Facebook",
subtitle = "Each arrow shows P1 → P2"
) +
coord_cartesian(clip = "off") +
theme_aa()
# ---- Plotları göster ----
p_instagram
p_facebook
p_combined
# ---- Numeric summary table ----
summary_tbl <- cadence_tbl |>
select(Platform, Period, posts_per_week, avg_views_post) |>
mutate(
posts_per_week = round(posts_per_week, 2),
avg_views_post = round(avg_views_post, 1)
)
print(summary_tbl)
# --- Minimal stats using existing `cadence_tbl`
stats_df <- cadence_tbl %>%
dplyr::select(Platform, Period, posts_per_week, avg_views_post) %>%
dplyr::filter(!is.na(posts_per_week), !is.na(avg_views_post))
# 1) Pearson correlation: cadence vs. visibility
cor_obj <- cor.test(stats_df$posts_per_week, stats_df$avg_views_post)
# 2) Simple linear regression (illustrative; very small n)
lm_fit  <- lm(avg_views_post ~ posts_per_week, data = stats_df)
lm_sum  <- summary(lm_fit)
# 3) Paired t-test by platform (P1 vs P2) — illustrative with 2 pairs
wide <- reshape(
stats_df[, c("Platform","Period","avg_views_post")],
idvar   = "Platform",
timevar = "Period",
direction = "wide"
)
paired_p <- NA
if (all(c("avg_views_post.P1 (Aug12–Sep10)", "avg_views_post.P2 (Sep26–Oct21)") %in% names(wide))) {
tpair <- t.test(
wide[["avg_views_post.P1 (Aug12–Sep10)"]],
wide[["avg_views_post.P2 (Sep26–Oct21)"]],
paired = TRUE
)
paired_p <- tpair$p.value
}
fmt <- function(x, d = 3) formatC(x, format = "f", digits = d)
cat("\n--- Statistical Summary (Cadence → Visibility) ---\n")
cat("Pearson r =", fmt(cor_obj$estimate, 2), " | p =", fmt(cor_obj$p.value), "\n")
cat("OLS slope (β for posts/week) =",
fmt(lm_sum$coefficients["posts_per_week","Estimate"], 2),
" | SE =", fmt(lm_sum$coefficients["posts_per_week","Std. Error"], 2),
" | p =", fmt(lm_sum$coefficients["posts_per_week","Pr(>|t|)"]), "\n")
if (!is.na(paired_p)) cat("Paired t-test (P1 vs P2 within platform): p =", fmt(paired_p), "\n")
cat("NOTE: Sample size is very small (n =", nrow(stats_df), "); results are illustrative.\n\n")
cat(
paste0(
"**Statistical note.** A Pearson correlation between posts per week and average views per post ",
"was r = ", fmt(cor_obj$estimate, 2), " (p = ", fmt(cor_obj$p.value), "). ",
"A simple linear regression indicated a positive association (slope β = ",
fmt(lm_sum$coefficients["posts_per_week","Estimate"], 1), ", p = ",
fmt(lm_sum$coefficients["posts_per_week","Pr(>|t|)"]), "). ",
if (!is.na(paired_p))
paste0("A paired comparison of P1 vs. P2 within platforms yielded p = ", fmt(paired_p), ". ")
else "",
"Given the very small sample (two platforms × two periods), these inferential results are ",
"demonstrative and should be interpreted with caution, yet they align with the descriptive uplift ",
"observed in the arrow plot."
),
"\n"
)
```{r save_figs, echo=TRUE}
